// 디지털 웰빙 타이머 — Firestore 보안 규칙
//
// 이 파일을 통째로 복사해서 Firebase 콘솔의 규칙 칸에 붙여넣으면 된다.
// (Firebase 콘솔 → Firestore Database → 규칙 → 전체 지우고 붙여넣기 → 게시)
//
// 큰 원칙
//  - 읽기는 누구나. 로그인이 없으니 서로의 기록을 봐야 한다.
//  - 쓰기는 형식이 정확히 맞을 때만. 필드 이름·종류·길이가 아래와 같아야
//    하고, 적혀 있지 않은 필드가 하나라도 섞이면 거부된다.
//  - 고치기는 아무도 못 한다. 남의 기록을 바꿀 수 없다.
//  - 지우기는 activeChallenges 만 된다. 도전이 끝나면 지워야 하기 때문이다.
//  - 여기에 안 적힌 보관함은 전부 막힌다 (맨 아래 규칙).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 타이머 기록 (내 기록 + 순위표) ----
    match /records_v2/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['nickname','goalMinutes','elapsedSeconds','result','at'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 8
                    && request.resource.data.goalMinutes is int
                    && request.resource.data.goalMinutes > 0
                    && request.resource.data.goalMinutes <= 120
                    && request.resource.data.elapsedSeconds is int
                    && request.resource.data.elapsedSeconds >= 0
                    && request.resource.data.elapsedSeconds <= 7200
                    && request.resource.data.result is string
                    && request.resource.data.result in ['success','left','gaveup']
                    && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }

    // ---- 게시판 글 ----
    match /posts_v2/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['nickname','goalMinutes','elapsedSeconds','message','at'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 8
                    && request.resource.data.goalMinutes is int
                    && request.resource.data.goalMinutes > 0
                    && request.resource.data.goalMinutes <= 120
                    && request.resource.data.elapsedSeconds is int
                    && request.resource.data.elapsedSeconds >= 0
                    && request.resource.data.elapsedSeconds <= 7200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 100
                    && request.resource.data.at is timestamp;
      allow update, delete: if false;

      // ---- 게시판 글에 달리는 응원 ----
      match /cheers/{cheerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(
                          ['nickname','emoji','message','at'])
                      && request.resource.data.nickname is string
                      && request.resource.data.nickname.size() > 0
                      && request.resource.data.nickname.size() <= 8
                      && request.resource.data.emoji is string
                      && request.resource.data.emoji.size() <= 8
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 30
                      && request.resource.data.at is timestamp;
        allow update, delete: if false;
      }
    }

    // ---- 닉네임 주인 확인용 ----
    // 만들기만 되고 고치거나 지울 수 없다. 그래서 비밀번호를 바꿀 수 없다.
    // 로그인이 없어서 "지금 바꾸려는 사람이 진짜 주인인지" 확인할 방법이
    // 없기 때문이다. 고치기를 열면 아무나 남의 닉네임을 빼앗을 수 있다.
    match /users/{nickname} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pinHash','at'])
                    && request.resource.data.pinHash is string
                    && request.resource.data.pinHash.size() == 64
                    && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }

    // ---- 지금 집중 중인 사람 ----
    // 문서 번호가 닉네임이라 한 사람이 여러 개 올라가지 않는다.
    match /activeChallenges/{nickname} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['nickname','mission','goalMinutes','startedAt','endAt'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 8
                    && request.resource.data.mission is string
                    && request.resource.data.mission.size() <= 20
                    && request.resource.data.goalMinutes is int
                    && request.resource.data.goalMinutes > 0
                    && request.resource.data.goalMinutes <= 120
                    && request.resource.data.startedAt is timestamp
                    && request.resource.data.endAt is timestamp;
      // 도전이 끝나면 지워야 한다. 안 지우면 계속 집중 중인 것처럼 남는다.
      allow delete: if true;
      allow update: if false;
    }

    // ---- 도전자에게 보내는 응원 ----
    // 숫자를 하나 두고 올리는 대신 문서를 하나씩 쌓아서 센다.
    // 숫자를 고치려면 update 권한이 필요한데, 그걸 열면 아무나 남의 기록을
    // 고칠 수 있게 된다.
    match /challengeCheers/{cheerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['challengeId','from','at'])
                    && request.resource.data.challengeId is string
                    && request.resource.data.challengeId.size() <= 40
                    && request.resource.data.from is string
                    && request.resource.data.from.size() > 0
                    && request.resource.data.from.size() <= 8
                    && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }

    // ---- 위에 안 적힌 것은 전부 막는다 ----
    // 옛날 records / posts 보관함도 여기에 걸려서 아무도 못 건드린다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
